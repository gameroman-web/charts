{
  "name": "charts",
  "private": true,
  "description": "Simple web tool for creating bar charts from CSV files",
  "type": "module",
  "imports": {
    "#styles": "./src/styles/global.css",
    "#app": "./src/components/App.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "astro build",
    "deploy": "wrangler deploy",
    "dev": "astro dev",
    "format": "biome check --write",
    "lint": "biome check",
    "preview": "astro preview",
    "quality": "bun run --sequential format test typecheck",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@babel/generator": "7.29.12",
    "@babel/helper-module-imports": "7.29.7",
    "@babel/parser": "7.29.12",
    "@babel/template": "7.29.7",
    "@babel/traverse": "7.29.12",
    "@babel/types": "7.29.11",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@jridgewell/trace-mapping": "0.3.31",
    "@napi-rs/wasm-runtime": "1.2.6",
    "debug": "npm:obug@1.0.2",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "unstorage": "2.0.0-beta.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "solid-js": "1.9.17",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/solid-js": "7.1.1",
    "@biomejs/biome": "2.6.3",
    "@gameroman/config": "0.3.0",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
